/ test/safetensors.k — read a small hand-built .safetensors file
/ Build the extension first:  zig build safetensors
/ Fixture generated by the snippet in lib/safetensors/README.md.

t: safetensors.read "test/data/tiny.safetensors"

`0 0: "tensors: ",$!t
w: t`weight
`0 0: "weight  ",($w`dtype)," ",$(w`shape)#w`data   / f32 2x3 matrix
`0 0: "bias    ",$(t`bias)`data                      / i32 vector
`0 0: "half    ",$(t`half)`data                      / F16  -> F
`0 0: "bf      ",$(t`bf)`data                        / BF16 -> F
`0 0: "big     ",$(t`big)`data                       / I64  -> I (overflow -> 0N)
`0 0: "flags   ",$(t`flags)`data                     / BOOL -> I

/ `__metadata__` has underscores (Drop in source) so build the symbol at runtime.
m: t@`s$"__metadata__"
`0 0: "meta    ",($!m)," = ",$. m
